# ============================================================================
# .gitignore — PulseOps V1
#
# PURPOSE: Excludes build artifacts, dependencies, environment secrets,
# and IDE-specific files from version control.
# ============================================================================

# Dependencies
node_modules/
api/node_modules/

# Build output
dist/
build/
.vite/

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.production
.env.staging
api/.env
api/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/
.nyc_output/

# Docker
docker-compose.override.yml
