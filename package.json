{
  "name": "pulseops-v1",
  "version": "1.0.0",
  "private": true,
  "description": "PulseOps V1 — Enterprise Modular Operations Platform with plug-and-play module architecture",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:api\"",
    "dev:ui": "vite",
    "dev:api": "cd api && npm run dev",
    "build": "vite build",
    "build:module": "node scripts/build-module.js",
    "build:modules": "node scripts/build-module.js --all",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .js,.jsx"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.294.0",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0"
  }
}
