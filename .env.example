# ============================================================================
# Environment Variables — PulseOps V1
#
# PURPOSE: Template for all required environment variables. Copy this file
# to .env and fill in your values. NEVER commit .env to version control.
#
# HOW TO USE:
#   cp .env.example .env
#   # Edit .env with your actual values
# ============================================================================

# ── API Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulseops_v1
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/pulseops.log

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Frontend (Vite) ─────────────────────────────────────────────────────────────
VITE_API_SERVER_URL=http://localhost:4000
